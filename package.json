{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual QA Tester CV and the system under test of a QA portfolio",
  "scripts": {
    "dev": "vite --configLoader runner",
    "prebuild": "npm run test:unit",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --port 4173 --strictPort",
    "lint": "eslint .",
    "build:pdf": "tsx scripts/build-pdfs.ts",
    "build:all": "npm run build && npm run build:pdf",
    "check:links": "tsx scripts/check-links.ts",
    "lighthouse": "lhci autorun",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --configLoader runner",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:visual:update": "node scripts/visual-docker.mjs --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
